# ============================================================
# ROOT .gitignore — NestJS Backend + Vite React Frontend
# ============================================================

# ---------------------------
# Dependencies
# ---------------------------
node_modules/
.pnp
.pnp.js

# ---------------------------
# Environment Variables (NEVER commit secrets!)
# ---------------------------
.env
.env.*
!.env.example

# ---------------------------
# Build Outputs
# ---------------------------
dist/
build/
out/

# ---------------------------
# NestJS / TypeScript
# ---------------------------
*.js.map
*.d.ts
tsconfig.tsbuildinfo

# ---------------------------
# Vite
# ---------------------------
.vite/

# ---------------------------
# Uploads (user-generated content)
# ---------------------------
backend/uploads/*
!backend/uploads/.gitkeep

# ---------------------------
# Logs
# ---------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------
# Testing & Coverage
# ---------------------------
coverage/
.nyc_output/

# ---------------------------
# OS & Editor Files
# ---------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------
# Misc
# ---------------------------
*.tgz
*.tar.gz
.cache/
.temp/
.tmp/

